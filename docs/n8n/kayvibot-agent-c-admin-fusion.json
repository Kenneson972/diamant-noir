{
  "name": "Kayvibot C — Admin (Fusion Améliorée)",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "kayvibot-admin", "responseMode": "responseNode", "options": {} },
      "id": "c-webhook", "name": "Webhook Trigger", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0], "webhookId": "kayvibot-admin"
    },
    {
      "parameters": { "assignments": { "assignments": [
        { "id": "c-s1", "name": "chatInput", "value": "={{ $json.body.chatInput || $json.body.message }}", "type": "string" },
        { "id": "c-s2", "name": "sessionId", "value": "={{ $json.body.sessionId || ('session-' + Date.now()) }}", "type": "string" },
        { "id": "c-s3", "name": "token", "value": "={{ $json.body.token || $json.headers?.authorization?.replace('Bearer ', '') || '' }}", "type": "string" }
      ] } },
      "id": "c-set", "name": "Edit Fields", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [220, 0]
    },
    {
      "parameters": { "url": "={{ $env.KAYVILA_URL || 'https://kayvila.vercel.app' }}/api/agent/admin-context", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $json.token }}" }] }, "options": { "timeout": 15000 } },
      "id": "c-fetch", "name": "Fetch Admin Context", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, 0], "continueOnFail": true
    },
    {
      "parameters": { "jsCode": "const ctxRes = $('Fetch Admin Context').first().json;\nif (ctxRes.statusCode === 401 || ctxRes.error === 'Unauthorized' || ctxRes.error === 'Forbidden' || ctxRes.error === 'Erreur serveur') {\n  return [{ json: { __unauthorized: true } }];\n}\nconst analytics = ctxRes.analytics || {};\nconst briefing = analytics.daily_briefing || {};\nconst health = analytics.health_score_by_villa || {};\nconst occupancy = analytics.occupancy_by_villa || {};\nconst alerts = analytics.admin_alerts || [];\nconst healthSummary = Object.entries(health).slice(0, 10).map(([k, v]) => `${k}: ${v}`).join(', ');\nconst occupancySummary = Object.entries(occupancy).slice(0, 10).map(([k, v]) => `${k}: ${v}%`).join(', ');\n// Utilise le systemPrompt de l'API (source de vérité) + append briefing live\nconst basePrompt = ctxRes.systemPrompt || '';\nconst systemMessage = basePrompt\n  + `\\n\\n- Utiliser tes outils (allVillas, allBookings, submissions, globalStats, otaAll, users) pour des données fraîches à la demande`\n  + `\\n\\n═════════════════════════════\\nBRIEFING : checkins=${briefing.checkins_today||0}, checkouts=${briefing.checkouts_today||0}, soumissions=${briefing.submissions_pending||0}\\nSANTÉ VILLAS : ${healthSummary || 'N/A'}\\nOCCUPATION (30j) : ${occupancySummary || 'N/A'}\\n⚠️ ${alerts.length} alerte(s) active(s)\\n═════════════════════════════`;\n\nreturn {\n  json: {\n    chatInput: $('Edit Fields').first().json.chatInput,\n    sessionId: $('Edit Fields').first().json.sessionId,\n    __unauthorized: false,\n    systemMessage\n  }\n};" },
      "id": "c-build", "name": "Build Context", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 1 }, "conditions": [{ "id": "c-c-unauth", "leftValue": "={{ $json.__unauthorized }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }], "combinator": "and" }
      },
      "id": "c-if-auth", "name": "IF - Non Autorisé ?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [880, 0]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify({ response: \"Accès refusé. Cette interface est réservée aux administrateurs Kayvila.\", action: \"error\", action_data: {}, suggested_prompts: [] }) }}", "options": { "responseCode": 401 } },
      "id": "c-resp-unauth", "name": "Respond - Non Autorisé", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1100, 200]
    },
    {
      "parameters": { "promptType": "define", "text": "={{ $json.chatInput }}", "options": { "systemMessage": "={{ $json.systemMessage }}" } },
      "id": "c-agent", "name": "AI Agent DeepSeek", "type": "@n8n/n8n-nodes-langchain.agent", "typeVersion": 3.1, "position": [1100, -200]
    },
    {
      "parameters": { "model": { "__rl": true, "value": "deepseek-chat", "mode": "list" }, "options": { "baseURL": "https://api.deepseek.com/v1", "temperature": 0.2 } },
      "id": "c-model", "name": "DeepSeek Chat Model", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "typeVersion": 1.3, "position": [1100, 0],
      "credentials": { "openAiApi": { "id": "DEEPSEEK_CRED", "name": "DeepSeek API" } }
    },
    {
      "parameters": { "toolDescription": "Liste TOUTES les villas de la plateforme (admin).", "method": "GET", "url": "https://kayvila.vercel.app/api/admin/villas", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $('Edit Fields').first().json.token }}" }] } },
      "id": "c-tool-villas", "name": "allVillas", "type": "@n8n/n8n-nodes-langchain.toolHttpRequest", "typeVersion": 1.1, "position": [1100, 200]
    },
    {
      "parameters": { "toolDescription": "Liste TOUTES les réservations de la plateforme (admin).", "method": "GET", "url": "https://kayvila.vercel.app/api/admin/bookings", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $('Edit Fields').first().json.token }}" }] } },
      "id": "c-tool-bookings", "name": "allBookings", "type": "@n8n/n8n-nodes-langchain.toolHttpRequest", "typeVersion": 1.1, "position": [1100, 360]
    },
    {
      "parameters": { "toolDescription": "Liste les soumissions de villas en attente de validation (admin).", "method": "GET", "url": "https://kayvila.vercel.app/api/admin/villa-submissions", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $('Edit Fields').first().json.token }}" }] } },
      "id": "c-tool-submissions", "name": "submissions", "type": "@n8n/n8n-nodes-langchain.toolHttpRequest", "typeVersion": 1.1, "position": [1100, 520]
    },
    {
      "parameters": { "toolDescription": "Statistiques globales, revenus Stripe, KPIs plateforme (admin).", "method": "GET", "url": "https://kayvila.vercel.app/api/admin/global-stats", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $('Edit Fields').first().json.token }}" }] } },
      "id": "c-tool-stats", "name": "globalStats", "type": "@n8n/n8n-nodes-langchain.toolHttpRequest", "typeVersion": 1.1, "position": [1100, 680]
    },
    {
      "parameters": { "toolDescription": "Santé de TOUTES les synchronisations OTA (Airbnb/Booking) de la plateforme (admin).", "method": "GET", "url": "https://kayvila.vercel.app/api/admin/ota-status", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $('Edit Fields').first().json.token }}" }] } },
      "id": "c-tool-ota", "name": "otaAll", "type": "@n8n/n8n-nodes-langchain.toolHttpRequest", "typeVersion": 1.1, "position": [1100, 840]
    },
    {
      "parameters": { "toolDescription": "Liste les propriétaires / utilisateurs de la plateforme (admin).", "method": "GET", "url": "https://kayvila.vercel.app/api/admin/owners", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $('Edit Fields').first().json.token }}" }] } },
      "id": "c-tool-users", "name": "users", "type": "@n8n/n8n-nodes-langchain.toolHttpRequest", "typeVersion": 1.1, "position": [1100, 1000]
    },
    {
      "parameters": { "jsCode": "const ai = $input.first().json.output || $input.first().json.text || '';\nlet response = ai, action = 'SHOW_STATS', action_data = {}, prompts = [];\ntry {\n  const p = typeof ai === 'string' ? JSON.parse(ai) : ai;\n  if (p && typeof p === 'object') {\n    response = p.response || p.reply || ai;\n    action = p.action || 'SHOW_STATS';\n    action_data = p.action_data || {};\n    prompts = Array.isArray(p.suggested_prompts) ? p.suggested_prompts : [];\n  }\n} catch {}\nreturn { json: { response, action, action_data, suggested_prompts: prompts, sessionId: $('Edit Fields').first().json.sessionId } };" },
      "id": "c-parse", "name": "Parse Response", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1320, -200]
    },
    {
      "parameters": {
        "schema": { "__rl": true, "value": "public", "mode": "list" },
        "table": { "__rl": true, "value": "conversation_memory", "mode": "list" },
        "columns": { "mappingMode": "defineBelow", "value": {
          "session_id": "={{ $json.sessionId }}",
          "conversation_data": "={{ { \"user\": $('Edit Fields').first().json.chatInput, \"assistant\": $json.response } }}",
          "metadata": "={{ { \"agent\": \"admin\", \"action\": $json.action } }}"
        }, "matchingColumns": [], "schema": [], "attemptToConvertTypes": false, "convertFieldsToString": false }
      },
      "id": "c-save", "name": "Save Memory", "type": "n8n-nodes-base.postgres", "typeVersion": 2.4, "position": [1540, -200],
      "continueOnFail": true,
      "credentials": { "postgres": { "id": "szSBC134iAZHEyPA", "name": "DIAMANT NOIR" } }
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify($('Parse Response').first().json) }}", "options": { "responseCode": 200 } },
      "id": "c-respond", "name": "Respond to Webhook", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1760, -200]
    }
  ],
  "connections": {
