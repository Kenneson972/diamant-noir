      "id": "87333379-edc6-40ef-8da7-3f4cccc0f789",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1392,
        352
      ],
      "webhookId": "kayvila-owner-webhook"
