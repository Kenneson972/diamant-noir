    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body || {};\nconst hdr = $('Webhook').first().json.headers || {};\nconst raw = (b.token || hdr.authorization || '').replace(/^Bearer\\s+/i, '');\nlet userId = '', role = '';\ntry {\n  const response = await fetch('https://VOTRE-PROJET-SUPABASE.supabase.co/auth/v1/user', {\n    headers: { Authorization: `Bearer ${raw}`, apikey: 'VOTRE_SUPABASE_ANON_KEY' }\n  });\n  if (!response.ok) throw new Error('Token invalid');\n  const user = await response.json();\n  userId = user.id || '';\n  role = (user.user_metadata && user.user_metadata.role) || (user.app_metadata && user.app_metadata.role) || '';\n} catch (e) {}\nconst valid = !!userId && String(role).toLowerCase() === 'admin';\nreturn [{ json: { userId, role, token: raw, sessionId: b.sessionid || ('admin-' + userId), userMessage: b.message || '', valid: valid ? 'true' : 'false' } }];"
      },
