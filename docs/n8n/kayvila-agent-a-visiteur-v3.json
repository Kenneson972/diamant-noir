      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body || {};\nconst sessionId = b.sessionid || ('visitor-' + Date.now() + '-' + Math.random().toString(36).substring(2, 11));\n// Extraction disponibilit\u00e9s (A1) et faits conciergerie du contexte inject\u00e9 par la route Next.js\nconst villas = b.context?.villas || [];\nconst availability = JSON.stringify(villas.map(v => ({ name: v.name, availability: v.availability })));\nconst conciergerieFacts = JSON.stringify(b.context?.conciergerieFacts || []);\nreturn [{ json: { sessionId, message: b.message || '', page: b.page || '', availability, conciergerieFacts } }];"
      },
