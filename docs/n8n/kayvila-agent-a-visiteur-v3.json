    {
      "parameters": {
        "jsCode": "const i = $input.first().json;\nconst sid = i.sessionId || $('Edit Fields').first().json.sessionId || '';\nlet t = i.output || i.text || \"D\u00e9sol\u00e9, je rencontre un souci technique. R\u00e9essaie dans un instant.\";\nt = t.replace(/\\*\\*(.*?)\\*\\*/g, '$1').replace(/^[ \\t]*#+[ \\t]+/gm, '').replace(/^[ \\t]*-+[ \\t]+/gm, '\u2022 ').trim();\nreturn [{ json: { response: t, sessionId: sid } }];"
      },
